ex69 is

  seed(s u64, f ()->unit) =>
    Random.simple s f

  show_random (msg String) =>
    for i in 0..5 do
      say "$msg random is $(Random.env.next_u32 100)"

  show_random "default"

  seed 777 ()->
    show_random "seeded with 777"

  Random.time_seeded (()->
    show_random "seeded with time")

  seed 777 ()->
    show_random "seeded with 777"
