# usage: $ echo -e "1\n2\n3\n" | fz src/idiom148ex.fz
ex =>

  # aborts when the first string that can't be
  # parsed as i64 is encountered
  lm : mutate is
  lm ! ()->
    io.buffered lm .Reader.instate (io.stdin.reader lm) ()->
      for
        l := (io.buffered lm).read_line ? str String => str.parse_i64.as_option | io.end_of_file => nil
      while l.exists
        say l
