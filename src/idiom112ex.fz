ex112 is

  mymap := (container.ordered_map String String .of
    [ "un", "deux", "trois", "quatre", "cinq" ]
    [ "ichi", "ni", "san"  , "yon"   , "go"   ] )

  for k in mymap.keys.sort do
    say "$k => $(mymap[k])"

  # since mymap is already ordered_map, mymap.keys are already ordered
  for k in mymap.keys do
    say "$k => $(mymap[k])"
