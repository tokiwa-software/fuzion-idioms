ex60 is

  show_args =>
    say "got $(envir.Args.env.count) args:"
    say "first arg is the program, skipping"
    for
      i in 1..envir.Args.env.count-1
      x := envir.Args.env[i]
    do
      say "arg#$i is $x"
    say ""

  # show args we are called with
  show_args

  # run show_args in a different environment using a different instance of the
  # envir.Args effect
  envir.Args.instate (_ : envir.Args is
                        public redef as_list list String =>
                          ["cmd","arg0","arg1"].as_list)
                     ()->show_args

  # run show_args in another environment
  envir.Args.instate (_ : envir.Args is
                        public redef as_list list String =>
                          (array 20 i->"a$i").as_list)
                     ()->show_args
