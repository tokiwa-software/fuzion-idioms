ex119 is

  # preserving order
  #
  x := [ $"b", "a", "b", "c" ]
  x1 := for
         r list String := nil, if e ∈ s then r
                                        else cons e r
         s := container.ps_set String .new (list String).empty, s.add e
         e in x
        else
         r.reverse
  say x1

  # not preserving order
  #
  x2 := [ "b", "a", "b", "c" ]
  x3 := container.ps_set codepoint .new x2
  say x3
