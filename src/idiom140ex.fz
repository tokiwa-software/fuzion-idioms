ex140 =>
    lm : mutate is
    lm ! ()->

        m := container.Mutable_Tree_Map lm String i64 .empty
        m.put "one" 1
        m.put "two" 2

        k := "one"
        say (m.remove k)        # out: 1 (removed value)
        say (m.remove "three")  # out: --nil-- (nothing to remove, m unchanged)
        say m                   # out: {"two": 2} (remaining map)
