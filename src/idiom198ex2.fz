ex198a is

  f =>
    say "in f, perform exit:"
    x := u8 4
    Exit.env.exit x
    say "** not reachable code **"

  my_exit : Exit is
    public redef abortable bool => true
    public redef exit(code u8) void =>
      io.Err.env.println "*** user defined exit handler diverting exit $code ***"
      Exit.abort
    public redef finally unit =>


  Exit.instate _ my_exit (()->
    f
    say "** not reachable code **") _->unit

  say "exit normally"
