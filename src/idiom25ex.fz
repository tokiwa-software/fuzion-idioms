ex25 is

  # to create an open channel that may
  # send an receive Strings
  chan := concur.Channel String

  _ := concur.Threads.env.spawn ()->
    # receive "Alan"
    say "Hello, $(<-chan)"
    # blocks until chan is closed, we then receive nil
    say <-chan

  chan <- "Alan"
  chan.close

  # we must not send anything to a closed Channel!
  # this would result in a precondition failure
  # chan <- "Wake"
