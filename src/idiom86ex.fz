ex86 is

  # using feature will_overflow_on_mul:
  multiply_will_overflow(x, y i64) => x.overflow_on_mul y

  # or using overflow-checking 'infix *?'
  multiply_will_overflow2(x, y i64) => !(x *? y)

  for x in 0x80000000..0xe0000000 : 0x20000000 do
    for y in 0x58000000..0xe8000000 : 0x30000000 do
      yap "$(x.hex) *° $(y.hex) "
      if multiply_will_overflow x y
        yap "will overflow    "
      else
        yap "will not overflow"

      yap " sum is $((x *° y).hex)"
      if multiply_will_overflow2 x y
        yap ", did overflow"
      else
        yap ", did not overflow"
      say ""
